# ---- Copy this file to .env and fill it in. Never commit .env. ----

# Supabase. Use the service role key ONLY on a trusted machine/server;
# it bypasses row-level security. Never put it in a browser or a chat.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=
TICKETS_TABLE=ReportedIssues
RUNS_TABLE=recreator_runs

# Claude
ANTHROPIC_API_KEY=
RECREATOR_MODEL=claude-opus-5-5

# Mattermost sandbox
MM_URL=http://localhost:8065
# Image to use. {version} is filled from the ticket's app_build_details.version.
MM_IMAGE_TEMPLATE=mattermost/mattermost-team-edition:{version}
# Optional overrides, e.g. for a custom build with a planted bug:
MM_IMAGE=
MM_LAST_GOOD_IMAGE=
# Optional: a git checkout of the Mattermost source at the ticket's version.
# Without it, the pipeline stops after reproduction (no code diagnosis).
MM_SOURCE_DIR=

# Safety limits (each turn = one Claude call)
MAX_RECREATOR_TURNS=40
MAX_DIAGNOSIS_TURNS=25
